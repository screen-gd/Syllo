{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "noEmit": true,
        "allowJs": true,
        "esModuleInterop": true,
        "baseUrl": "..",
        "paths": { "@/*": ["src/*"] }
    },
    "include": ["./**/*.ts"]
}
