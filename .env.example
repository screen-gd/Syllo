# Public origin used for canonical URLs, Open Graph/Twitter tags, robots.txt
# and sitemap.xml. No trailing slash.
VITE_APP_URL=http://localhost:3000

# Optional server-side OpenAI key. Visitors can also bring their own key in
# Settings; this one is only a fallback for server-side AI calls.
OPENAI_API_KEY=

# Port and interface used by `npm start` (server.mjs). The app has no login,
# so it listens on 127.0.0.1 unless HOST says otherwise.
# PORT=3000
# HOST=127.0.0.1

# --- Scout -----------------------------------------------------------------
# Scout keeps one SQLite file. Defaults to .data/syllo.db in the repo.
# SCOUT_DB_PATH=C:\path\to\syllo.db

# Which model Scout uses when a pack starts without a key from Settings.
# Defaults: deepseek / deepseek-chat (DeepSeek V4.1 Flash alias).
# SCOUT_PROVIDER=deepseek
# SCOUT_MODEL=deepseek-chat

# Server-side provider keys. Scout uses the same provider map as the studio,
# so any one of these works. Without a key, pass one from Settings per pack;
# nightly auto-check never needs a key.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Discovery. YouTube Data API v3 is only used for channel uploads; Scout never
# calls search.list. Without a key, YouTube falls back to channel RSS and page
# HTML. Exa powers the open-web half of discovery.
YOUTUBE_API_KEY=
EXA_API_KEY=

# Article and documentation text via Jina Reader. Works without a key at a
# lower rate limit.
JINA_API_KEY=

# Transcript fallback when the local Python helper is unavailable or blocked.
SUPADATA_API_KEY=

# Delay between YouTube transcript attempts, in ms. Defaults to 150000
# (2.5 minutes); values below 30000 are raised to the floor.
# SCOUT_TRANSCRIPT_INTERVAL_MS=150000
