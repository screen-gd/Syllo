# Public origin used for canonical URLs, Open Graph/Twitter tags, robots.txt
# and sitemap.xml. No trailing slash.
VITE_APP_URL=http://localhost:3000

# Password that unlocks the app (the gate at /gate). When unset, the gate stays
# locked because the comparison fails closed.
GATE_PASSWORD=

# Optional server-side OpenAI key. Visitors can also bring their own key in
# Settings; this one is only a fallback for server-side AI calls.
OPENAI_API_KEY=

# Port used by `npm start` (server.mjs). Defaults to 3000.
# PORT=3000
