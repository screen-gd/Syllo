# Public origin used for canonical URLs, Open Graph/Twitter tags, robots.txt
# and sitemap.xml. No trailing slash.
VITE_APP_URL=http://localhost:3000

# Leave these blank for local mode. Deployment URLs are public, never API keys.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Local production host listens on loopback by default.
# PORT=3000
# HOST=127.0.0.1

# --- Scout -----------------------------------------------------------------
# Scout keeps one SQLite file. Defaults to .data/syllo.db in the repo.
# SCOUT_DB_PATH=C:\path\to\syllo.db

# Free-only AI. Use an unbilled Google AI Studio project.
# Browser Settings can supply a key instead; it is not synced.
SCOUT_PROVIDER=gemini
SCOUT_MODEL=gemini-2.5-flash

GEMINI_API_KEY=

# Optional YouTube Data API key for broader video search and metadata.
# Without it, creator RSS and Gemini grounded search supply candidates.
YOUTUBE_API_KEY=
# Articles use keyless Jina Reader and direct page fetches.
# Paid Exa/Supadata fallbacks and authenticated Jina requests are disabled.

# Delay between YouTube transcript attempts, in ms. Defaults to 150000
# (2.5 minutes); values below 30000 are raised to the floor.
# SCOUT_TRANSCRIPT_INTERVAL_MS=150000
